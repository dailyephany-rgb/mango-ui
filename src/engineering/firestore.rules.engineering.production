/**
 * Production-oriented rules template for a DEDICATED eng project only.
 * For shared vasundhara project, merge eng_* allow from firestore.rules.engineering
 * into existing clinical rules — never replace clinical rules with this file.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOps() {
      return request.auth != null
        && request.auth.uid in [
          // 'REPLACE_WITH_OPS_UID_1',
        ];
    }

    function isEngCol(col) {
      return col.matches('eng_.*');
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /{col}/{docId} {
      allow read: if isEngCol(col) && isOps();
      allow write: if isEngCol(col);
    }
  }
}

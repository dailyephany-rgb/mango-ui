rules_version = '2';
/**
 * ROE-MANGO-UI-2026-0913 — EMERGENCY LOCKDOWN
 * Deny all client access until proper Auth + scoped eng rules land.
 * Engineering project: mango-engineering
 * Deploy: npm run eng:deploy
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

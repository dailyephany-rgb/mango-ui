/**
 * Shared Engineering Firebase security rules MERGE FRAGMENT for vasundhara-4c6e5.
 *
 * DO NOT deploy this file alone — it would wipe clinical rules.
 * Use: npm run eng:ops-deploy  (fetches live rules, merges this fragment, deploys)
 *
 * Clinical impact: NONE — eng_* prefix only.
 *
 * Retention: client delete allowed ONLY when expireAt is in the past
 * (stamped by eng writers). Fresh eng_* docs cannot be wiped.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== BEGIN ENG MERGE BLOCK (mango-ui) =====
    function isEngCol(col) {
      return col.matches('eng_.*');
    }

    function hasEngWriteSchema() {
      return request.resource.data.keys().hasAll(['schemaVersion', 'deviceId'])
        || request.resource.data.keys().hasAll(['schemaVersion', 'telemetryVersion']);
    }

    function engExpired() {
      return resource.data.keys().hasAny(['expireAt'])
        && resource.data.expireAt is timestamp
        && request.time > resource.data.expireAt;
    }

    match /{col}/{docId} {
      allow read: if isEngCol(col);

      allow create, update: if isEngCol(col) && hasEngWriteSchema();

      // Retention-only deletes: past expireAt. Blocks wipe of live telemetry.
      allow delete: if isEngCol(col) && engExpired();
    }
    // ===== END ENG MERGE BLOCK (mango-ui) =====

    // Keep all existing clinical match rules below / above as they are today.
  }
}

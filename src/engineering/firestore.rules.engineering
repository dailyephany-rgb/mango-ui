/**
 * Example Engineering Firebase security rules for SHARED project vasundhara-4c6e5.
 *
 * DO NOT deploy this file alone — it would wipe clinical rules.
 * Merge the eng_* match block into your existing clinical Firestore rules in Console.
 *
 * Collections used by Engineering / Performance ops plane:
 *   eng_devices, eng_device_status, eng_heartbeat_hourly, eng_departments,
 *   eng_firestore_metrics, eng_pages, eng_page_loads, eng_network, eng_memory, eng_react_metrics,
 *   eng_errors, eng_audit, eng_health, eng_settings, eng_builds, eng_alerts,
 *   eng_listener_daily
 *   (+ optional debug: heartbeats — prefer eng_heartbeats if you enable debugSampling)
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== MERGE THIS BLOCK into existing clinical rules =====
    match /{col}/{docId} {
      allow read, write: if col.matches('eng_.*');
    }
    // ===== END MERGE =====

    // Keep all existing clinical match rules below / above as they are today.
  }
}
